{
  "name": "keep-ios",
  "private": true,
  "version": "1.0.0",
  "description": "The Keep iPhone app: the same pages as the web app, wrapped so it can read your photo library.",
  "scripts": {
    "web": "python3 build.py",
    "sync": "python3 build.py && cap sync ios",
    "open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor-community/media": "^9.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@capacitor/assets": "^3.0.0"
  }
}
