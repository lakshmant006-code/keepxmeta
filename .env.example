# Copy to .env for local builds (python3 build.py). Never commit .env.
# For the deployed site, set these as GitHub repository secrets instead (Settings > Secrets and variables > Actions).
GM_KEY=
# Optional, Firebase App Check for Google Maps Platform
# FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","appId":"..."}
# RECAPTCHA_KEY=
# Optional, one-tap Instagram sign-in (see README, Instagram sign-in). IG_API is the URL of the deployed worker/instagram.js
# IG_APP_ID=
# IG_API=
# Server-side only (never built into the web app): a key for an LLM service, for a future worker. Keep it in .env or a worker secret.
# LLM_API_KEY=
# Optional, Google tag (Google Analytics) ID, e.g. G-XXXXXXXXXX. Off when empty. Sends page views only, never memories.
# GTAG_ID=
# KEEP_DEMO=1 builds the sample-data demo instead of the real app
KEEP_DEMO=0
